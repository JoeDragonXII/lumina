    "description":  "Lumina 鈥?local-first personal photography archive with galleries, timeline and maps.",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev frontend -p 3002",
                    "dev:frontend":  "next dev frontend -p 3002",
                    "build":  "next build frontend",
